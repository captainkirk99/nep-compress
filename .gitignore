# Prerequisites
build/
build-*/
b/*
examples/performance/*.jpg
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Spack: environment state, lockfile, and develop-build output in the source tree
.spack-env/
spack/ci/spack.lock
spack-build-*
spack-configure-args.txt

# Python bytecode (Spack imports package.py and writes __pycache__ next to it)
__pycache__/
*.pyc

# rattler-build default output directory (local builds without --output-dir)
output/
build-linux-*
spack/ci-local/
.ci-spack/
.ci-spack-packages/
